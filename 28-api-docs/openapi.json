{
  "openapi": "3.0.3",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "Contoh API terdokumentasi dengan OpenAPI (modul 28)."
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/books": {
      "get": {
        "summary": "Daftar semua buku",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Book" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Tambah buku",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/BookInput" } }
          }
        },
        "responses": {
          "201": { "description": "Dibuat", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } } },
          "400": { "description": "Input tidak valid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "author": { "type": "string" }
        }
      },
      "BookInput": {
        "type": "object",
        "required": ["title", "author"],
        "properties": {
          "title": { "type": "string" },
          "author": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
